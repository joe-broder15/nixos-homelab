#!/usr/bin/env bash
# Blocks commits that don't evaluate, and auto-formats staged .nix files.
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "==> nix flake check --no-build"
# --impure: flake.nix reads /etc/nixos/hardware-configuration.nix from the host.
if ! nix flake check --no-build --impure; then
  echo "error: nix flake check failed; commit aborted." >&2
  exit 1
fi

echo "==> nix fmt (staged files only)"
mapfile -d '' staged < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.nix')
if [ "${#staged[@]}" -gt 0 ]; then
  nix fmt -- "${staged[@]}" >/dev/null
  git add -- "${staged[@]}"
fi

exit 0
